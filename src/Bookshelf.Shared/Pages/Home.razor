@page "/"
@page "/search"
@inject IBookshelfApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>Search</PageTitle>

<section class="page-block">
    <h1>Search Catalog</h1>
    <p class="page-subtitle">
        Find books in FantLab and inspect current catalog status before adding a media source.
    </p>

    <form class="panel" @onsubmit="SubmitSearchAsync">
        <div class="grid-2">
            <label class="field">
                <span>Title</span>
                <input class="touch-target" @bind="_title" @bind:event="oninput" />
            </label>
            <label class="field">
                <span>Author</span>
                <input class="touch-target" @bind="_author" @bind:event="oninput" />
            </label>
        </div>

        <div class="action-row">
            <button class="btn touch-target" type="submit" disabled="@_isLoading">Search</button>
            <span class="hint">At least one field is required.</span>
        </div>
    </form>
</section>

@if (_isLoading)
{
    <p class="state-text">Loading search results...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel state-panel state-error" role="alert">
        <h2>Search failed</h2>
        <p>@_error</p>
        <button class="btn btn-secondary touch-target" type="button" @onclick="RetrySearchAsync">Retry</button>
    </section>
}
else if (_hasSearched && _response is not null && _response.Items.Count == 0)
{
    <section class="panel state-panel">
        <h2>No matches found</h2>
        <p>Try a broader title or author query.</p>
    </section>
}
else if (_response is not null)
{
    <section class="page-block">
        <div class="panel">
            <div class="list-head">
                <h2>Results (@_response.Total)</h2>
                <span>Page @_response.Page</span>
            </div>

            <ul class="result-list">
                @foreach (var item in _response.Items)
                {
                    var badge = GetCatalogBadge(item);

                    <li class="result-card">
                        <div class="result-main">
                            <a class="result-title" href="@BuildResultHref(item)">
                                @item.Title
                            </a>
                            @if (item.Authors.Count > 0)
                            {
                                <div class="result-meta">
                                    @string.Join(", ", item.Authors)
                                </div>
                            }
                            @if (item.Kind.Equals(SearchItemKinds.Series, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="result-meta">
                                    Series result
                                </div>
                            }
                            else if (item.Series is not null)
                            {
                                <div class="result-meta">
                                    Series: @item.Series.Title (book @item.Series.Order)
                                </div>
                            }
                        </div>

                        <span class="@($"badge {badge.CssClass}")">@badge.Label</span>
                    </li>
                }
            </ul>

            <div class="pagination">
                <button
                    class="btn btn-secondary touch-target"
                    type="button"
                    disabled="@(_response.Page <= 1)"
                    @onclick="PreviousPageAsync">
                    Previous
                </button>
                <button
                    class="btn btn-secondary touch-target"
                    type="button"
                    disabled="@((_response.Page * _response.PageSize) >= _response.Total)"
                    @onclick="NextPageAsync">
                    Next
                </button>
            </div>
        </div>
    </section>
}

@code {
    private const int DefaultPageSize = 20;

    private string? _title;
    private string? _author;
    [Parameter]
    [SupplyParameterFromQuery(Name = "title")]
    public string? QueryTitle { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "author")]
    public string? QueryAuthor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "page")]
    public int? QueryPage { get; set; }

    private SearchBooksResponse? _response;
    private bool _isLoading;
    private bool _hasSearched;
    private string? _error;
    private int _page = 1;

    protected override async Task OnParametersSetAsync()
    {
        var title = NormalizeOptional(QueryTitle);
        var author = NormalizeOptional(QueryAuthor);
        var page = QueryPage.GetValueOrDefault(1);
        if (page < 1)
        {
            page = 1;
        }

        _title = title;
        _author = author;
        _page = page;
        _error = null;

        if (string.IsNullOrWhiteSpace(title) && string.IsNullOrWhiteSpace(author))
        {
            _response = null;
            _hasSearched = false;
            _isLoading = false;
            return;
        }

        await SearchAsync(title, author, page);
    }

    private Task SubmitSearchAsync()
    {
        var title = NormalizeOptional(_title);
        var author = NormalizeOptional(_author);
        if (string.IsNullOrWhiteSpace(title) && string.IsNullOrWhiteSpace(author))
        {
            _response = null;
            _hasSearched = true;
            _error = "Provide title or author.";
            return Task.CompletedTask;
        }

        NavigateToSearch(title, author, 1);
        return Task.CompletedTask;
    }

    private async Task RetrySearchAsync()
    {
        await SearchAsync(_title, _author, _page);
    }

    private Task PreviousPageAsync()
    {
        NavigateToSearch(_response?.Query.Title ?? _title, _response?.Query.Author ?? _author, Math.Max(1, _page - 1));
        return Task.CompletedTask;
    }

    private Task NextPageAsync()
    {
        NavigateToSearch(_response?.Query.Title ?? _title, _response?.Query.Author ?? _author, _page + 1);
        return Task.CompletedTask;
    }

    private async Task SearchAsync(string? title, string? author, int page)
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(title) && string.IsNullOrWhiteSpace(author))
        {
            _response = null;
            _hasSearched = true;
            _error = "Provide title or author.";
            return;
        }

        _isLoading = true;
        _hasSearched = true;
        _page = page;

        try
        {
            _response = await ApiClient.SearchBooksAsync(
                title,
                author,
                page,
                DefaultPageSize);
            _title = _response.Query.Title;
            _author = _response.Query.Author;
        }
        catch (ApiClientException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateToSearch(string? title, string? author, int page)
    {
        var safePage = page < 1 ? 1 : page;
        var query = BuildQuery(
            ("title", NormalizeOptional(title)),
            ("author", NormalizeOptional(author)),
            ("page", safePage.ToString()));

        NavigationManager.NavigateTo($"/search{query}");
    }

    private string BuildResultHref(SearchBookItemDto item)
    {
        var returnUrl = BuildSearchUrl(_response?.Query.Title ?? _title, _response?.Query.Author ?? _author, _response?.Page ?? _page);
        var encodedReturnUrl = Uri.EscapeDataString(returnUrl);

        if (item.Kind.Equals(SearchItemKinds.Series, StringComparison.OrdinalIgnoreCase))
        {
            var providerSeriesKey = NormalizeOptional(item.ProviderSeriesKey);
            if (!string.IsNullOrWhiteSpace(providerSeriesKey))
            {
                return $"/series/{item.ProviderCode}/{providerSeriesKey}?returnUrl={encodedReturnUrl}";
            }
        }

        return $"/books/{item.ProviderCode}/{item.ProviderBookKey}?returnUrl={encodedReturnUrl}";
    }

    private static string BuildSearchUrl(string? title, string? author, int page)
    {
        var query = BuildQuery(
            ("title", NormalizeOptional(title)),
            ("author", NormalizeOptional(author)),
            ("page", page.ToString()));
        return $"/search{query}";
    }

    private static string BuildQuery(params (string Key, string? Value)[] values)
    {
        var items = values
            .Where(x => !string.IsNullOrWhiteSpace(x.Value))
            .Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value!)}")
            .ToArray();

        return items.Length == 0 ? string.Empty : $"?{string.Join("&", items)}";
    }

    private static string? NormalizeOptional(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var collapsed = string.Join(' ', value.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries));
        return string.IsNullOrWhiteSpace(collapsed) ? null : collapsed;
    }

    private static (string Label, string CssClass) GetCatalogBadge(SearchBookItemDto item)
    {
        if (item.Kind.Equals(SearchItemKinds.Series, StringComparison.OrdinalIgnoreCase))
        {
            return ("Series", "badge-series");
        }

        if (item.CatalogState.Equals("library", StringComparison.OrdinalIgnoreCase))
        {
            return ("In Library", "badge-library");
        }

        if (item.CatalogState.Equals("archive", StringComparison.OrdinalIgnoreCase))
        {
            return ("In Archive", "badge-archive");
        }

        return ("Not Added", "badge-not-added");
    }
}
